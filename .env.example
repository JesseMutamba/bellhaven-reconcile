# Copy to .env. Demo mode never connects to an external CRM.
APP_MODE=demo
DB_PATH=data/bellhaven.sqlite3
PORT=8765

# Set APP_MODE=live and DB_PATH=data/assessment.sqlite3 for the assessment CRM.
# Enter the candidate token and Bellhaven parent ID. Writes require app approval.
CRM_BASE_URL=https://analyst-assessment-production.up.railway.app/api/v1
CRM_API_TOKEN=
CRM_PARENT_ID=
WEBSITE_URL=https://analyst-assessment-production.up.railway.app/
SCRAPE_PATH_PATTERN=/(locations|communities|facilities)(/|\?|$)
SCRAPE_MAX_PAGES=100
SCRAPE_EXPECTED_MIN=35
# Enable only after verifying that the crawl covers the complete portfolio.
SCRAPE_ALLOW_ABSENCE_REVIEW=false
